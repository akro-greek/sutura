<div class="flex items-end justify-between"><div><p class="text-xs uppercase tracking-[0.25em] text-amber-300">Reviewer workspace</p><h1 class="mt-2 font-serif text-4xl">Candidate inbox</h1></div><div class="flex gap-2"><% [nil, *CandidateMatch.statuses.keys].each do |status| %><%= link_to(status || "all", reviewer_candidate_matches_path(status:), class: "rounded-full px-3 py-2 text-xs #{status == @status ? 'bg-amber-200 text-stone-950' : 'bg-white/5 text-stone-400'}") %><% end %></div></div>
<div class="mt-8 overflow-hidden rounded-2xl border border-white/10"><% @candidate_matches.each do |match| %><%= link_to reviewer_candidate_match_path(match), class: "grid gap-3 border-b border-white/10 bg-stone-900/40 p-5 last:border-0 hover:bg-stone-900 md:grid-cols-[1fr_1fr_auto]" do %><div><p class="text-xs text-stone-500"><%= match.source_passage.scroll.identifier %> · <%= match.source_passage.label %></p><p class="mt-2 font-serif text-lg"><%= match.source_passage.reading&.unicode_text %></p></div><div><p class="text-xs text-amber-300"><%= match.target_corpus_passage.corpus_work.title %> · <%= match.target_corpus_passage.citation %></p><p class="mt-2 text-sm text-stone-400"><%= match.target_corpus_passage.content %></p></div><div class="text-right"><span class="rounded-full bg-white/5 px-3 py-1 text-[10px] uppercase"><%= match.status %></span><p class="mt-3 text-xs text-stone-600"><%= number_with_precision(match.combined_score, precision: 3) %></p></div><% end %><% end %></div>
