<%= link_to "← Candidate inbox", reviewer_candidate_matches_path, class: "text-sm text-stone-500 hover:text-white" %>
<div class="mt-6 grid gap-6 lg:grid-cols-2"><section class="rounded-2xl border border-white/10 bg-stone-900 p-7"><p class="text-xs uppercase tracking-[0.2em] text-stone-500">Scroll reading</p><h1 class="mt-4 font-serif text-3xl leading-relaxed"><%= @candidate_match.source_passage.reading&.diplomatic_text %></h1><p class="mt-4 text-stone-500"><%= @candidate_match.source_passage.reading&.unicode_text %></p></section><section class="rounded-2xl border border-amber-300/20 bg-amber-100/5 p-7"><p class="text-xs uppercase tracking-[0.2em] text-amber-300"><%= @candidate_match.target_corpus_passage.corpus_work.title %> · <%= @candidate_match.target_corpus_passage.citation %></p><p class="mt-4 font-serif text-3xl leading-relaxed"><%= @candidate_match.target_corpus_passage.content %></p></section></div>
<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_420px]"><section class="rounded-2xl border border-white/10 p-6"><h2 class="font-serif text-2xl">Evidence</h2><div class="mt-4 space-y-3"><% @candidate_match.match_evidences.each do |evidence| %><div class="rounded-xl bg-white/5 p-4"><div class="flex justify-between"><strong><%= evidence.channel %></strong><span><%= number_with_precision(evidence.score, precision: 4) %></span></div><pre class="mt-3 overflow-auto text-xs text-stone-500"><%= JSON.pretty_generate(evidence.details) %></pre></div><% end %></div></section><section class="rounded-2xl border border-white/10 bg-stone-900 p-6"><h2 class="font-serif text-2xl">Record decision</h2><%= form_with model: [:reviewer, @candidate_match, @decision], class: "mt-5 space-y-4" do |form| %><%= form.select :verdict, ReviewDecision.verdicts.keys.map { |value| [value.humanize, value] }, {}, class: "w-full rounded-lg border border-white/10 bg-stone-950 px-3 py-3" %><%= form.text_area :note, rows: 5, placeholder: "Rationale (required for rejection)", class: "w-full rounded-lg border border-white/10 bg-stone-950 px-3 py-3" %><%= form.submit "Append decision", class: "w-full rounded-lg bg-amber-200 px-4 py-3 font-semibold text-stone-950 hover:bg-amber-100" %><% end %><p class="mt-4 text-xs leading-5 text-stone-600">Decisions are immutable and written to the audit trail.</p></section></div>
