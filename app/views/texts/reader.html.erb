<% content_for :title, "#{@scroll.identifier} — Sutura" %>
<% image_artifact = @scroll.source_artifacts.find { |artifact| artifact.kind.in?(%w[image dzi]) } %>
<% region = @selected_line&.image_regions&.first %>

<% if params[:tour].present? %>
  <aside class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-amber-200/25 bg-amber-200/10 p-5">
    <div><p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-amber-300">Guided tour · step 1 of 3</p><p class="mt-2 text-sm text-stone-200">Start with the evidence chain: published surface → diplomatic reading → transparent candidate parallels.</p></div>
    <%= link_to "Continue to reviewer preview →", showcase_review_path, class: "rounded-full bg-amber-200 px-5 py-2.5 text-xs font-semibold text-stone-950 hover:bg-amber-100" %>
  </aside>
<% end %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-xs uppercase tracking-[0.25em] text-amber-300"><%= @scroll.identifier %> · <%= @scroll.language %> · <%= @scroll.dating %></p>
    <h1 class="mt-2 font-serif text-4xl"><%= @scroll.title %></h1>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-stone-400"><%= @scroll.description %></p>
  </div>
  <div class="flex gap-3 text-xs">
    <%= link_to "EpiDoc", epidoc_export_path(@scroll.slug), class: "rounded-full border border-white/15 px-4 py-2 hover:border-amber-300/50" %>
    <%= link_to "JSON-LD", graph_export_path(@scroll.slug), class: "rounded-full border border-white/15 px-4 py-2 hover:border-amber-300/50" %>
    <%= link_to "CSV", matches_export_path(@scroll.slug), class: "rounded-full border border-white/15 px-4 py-2 hover:border-amber-300/50" %>
  </div>
</div>

<div class="grid min-h-[720px] overflow-hidden rounded-2xl border border-white/10 bg-stone-900 lg:grid-cols-[minmax(340px,1.1fr)_minmax(360px,.9fr)]">
  <section class="relative min-h-[420px] border-b border-white/10 bg-black lg:border-b-0 lg:border-r">
    <div class="absolute left-4 top-4 z-10 flex flex-wrap gap-2">
      <span class="rounded-full bg-black/75 px-3 py-1 text-xs text-stone-300">Official complete surface · zoom and pan</span>
      <% if region&.geometry&.fetch("confidence", nil) == "approximate" %><span class="rounded-full bg-amber-950/90 px-3 py-1 text-xs text-amber-200">Approximate column band</span><% end %>
    </div>
    <% if image_artifact %>
      <div class="h-full min-h-[520px]" data-controller="scroll-viewer"
        data-scroll-viewer-image-value="<%= image_artifact.local_path.presence || image_artifact.source_url %>"
        data-scroll-viewer-region-value="<%= region&.geometry.to_json %>"></div>
    <% else %>
      <div class="grid h-full place-items-center text-sm text-stone-500">No image artifact in this manifest.</div>
    <% end %>
  </section>

  <section class="grid min-w-0 grid-rows-[auto_1fr]">
    <nav class="flex gap-2 overflow-x-auto border-b border-white/10 p-3" aria-label="Columns">
      <% @columns.each do |column| %>
        <% number = column.anchor.delete_prefix("column-") %>
        <%= link_to column.label, text_column_path(@scroll.slug, number), class: "whitespace-nowrap rounded-lg px-3 py-2 text-xs #{column == @column ? 'bg-amber-200 text-stone-950' : 'bg-white/5 text-stone-400 hover:bg-white/10'}" %>
      <% end %>
    </nav>

    <div class="grid min-h-0 md:grid-cols-[118px_1fr]">
      <aside class="border-r border-white/10 p-3">
        <p class="mb-3 px-2 text-[10px] uppercase tracking-[0.2em] text-stone-600">Lines</p>
        <div class="space-y-1">
          <% @lines.each do |line| %>
            <% number = line.anchor.split("-line-").last %>
            <%= link_to line.label, text_line_path(@scroll.slug, @column.anchor.delete_prefix("column-"), number),
              class: "block rounded-lg px-3 py-2 text-sm #{line == @selected_line ? 'bg-amber-100/15 text-amber-200' : 'text-stone-500 hover:bg-white/5 hover:text-stone-200'}" %>
          <% end %>
        </div>
      </aside>

      <article class="overflow-y-auto p-6">
        <% if @selected_line&.reading %>
          <div class="flex items-center justify-between">
            <p class="text-xs uppercase tracking-[0.2em] text-stone-500"><%= @column.label %> · <%= @selected_line.label %></p>
            <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-[10px] uppercase tracking-wider text-emerald-300"><%= @selected_line.reading.editorial_status %></span>
          </div>
          <section class="mt-7">
            <p class="text-[10px] uppercase tracking-[0.2em] text-stone-600">Diplomatic reading</p>
            <p class="mt-3 font-serif text-3xl leading-relaxed text-stone-100"><%= @selected_line.reading.diplomatic_text %></p>
          </section>
          <section class="mt-8 grid gap-5 border-t border-white/10 pt-6 sm:grid-cols-2">
            <div><p class="text-[10px] uppercase tracking-[0.2em] text-stone-600">Normalized</p><p class="mt-2 font-serif text-lg text-stone-300"><%= @selected_line.reading.unicode_text %></p></div>
            <div><p class="text-[10px] uppercase tracking-[0.2em] text-stone-600">Translation</p><p class="mt-2 text-sm leading-6 text-stone-400"><%= @selected_line.reading.translation.presence || "No translation supplied" %></p></div>
          </section>
          <section class="mt-8 border-t border-white/10 pt-6">
            <div class="flex items-center justify-between"><div><p class="text-xs uppercase tracking-[0.2em] text-stone-500">Candidate parallels</p><p class="mt-1 text-xs text-stone-600">Research leads, not accepted claims</p></div><span class="text-xs text-stone-600"><%= @matches&.size || @selected_line.candidate_matches.count %> results</span></div>
            <%= render "candidate_matches/list", matches: (@matches || @selected_line.candidate_matches.ranked.includes(:match_evidences, target_corpus_passage: :corpus_work)) %>
          </section>
        <% else %>
          <p class="text-stone-500">This column has no imported lines.</p>
        <% end %>
      </article>
    </div>
  </section>
</div>

<section class="mt-6 rounded-xl border border-white/10 bg-stone-900/40 p-5 text-sm text-stone-400">
  <div class="flex flex-wrap items-start justify-between gap-5">
    <div class="max-w-4xl"><strong class="text-stone-200">Provenance.</strong>
      <% @scroll.source_artifacts.each do |artifact| %><p class="mt-2"><%= artifact.title %> · <%= artifact.data_license %> · <%= artifact.citation %></p><% end %>
    </div>
    <% if image_artifact&.source_url.present? %><%= link_to "Open original release ↗", @scroll.metadata["source_page"], target: "_blank", rel: "noreferrer", class: "text-amber-300 hover:text-amber-200" %><% end %>
  </div>
</section>
